DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB
PORT=3000
NODE_ENV=development
# Production must intentionally select direct or trusted-proxy before startup.
INGRESS_MODE=direct
# Required only in trusted-proxy mode: operator-verified IPs/CIDRs, no Render defaults.
TRUSTED_PROXY_CIDRS=
DB_PATH=studypilot.db
MAIL_PROVIDER=console
MAIL_API_KEY=YOUR_BREVO_API_KEY
MAIL_FROM=verified-sender@example.com
APP_URL=http://localhost:3000
